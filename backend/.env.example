# backend/.env.example — Copy this to .env and fill in your values
# NEVER commit .env — only commit .env.example

# PostgreSQL connection string
DATABASE_URL=postgresql://cms_user:cms_pass@localhost:5432/cms_db

# JWT secret key — generate a strong random key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# JWT algorithm (keep as HS256)
ALGORITHM=HS256

# How long login tokens last (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30
